{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "4seas-live-training",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-26",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "4seas-training",
      "database_id": "b57eed76-3697-4c47-97e2-f55cb1fa9aae",
      "migrations_dir": "./migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ASSET_BUCKET",
      "bucket_name": "4seas-training-assets"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "RoomHub" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomHub"] }]
}
